{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/product/*.md",
    "docs/domain/*.md",
    "docs/architecture/*.md"
  ],
  "permission": {
    "bash": {
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git fetch*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git switch*": "deny",
      "git branch *": "deny",
      "git tag *": "deny",
      "git remote *": "deny"
    }
  }
}
